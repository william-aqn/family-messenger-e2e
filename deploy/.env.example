# docker (containers) | native (systemd services built from source); set by install.sh.
INSTALL_MODE=docker
# Public host name (DNS must point to this machine). Use "localhost" for a local test.
DOMAIN=chat.example.com
# Public IP of this machine, used by coturn for relay candidates.
EXTERNAL_IP=203.0.113.10
# Shared secret between the server and coturn. Generate: openssl rand -hex 32
TURN_SECRET=change-me-to-a-long-random-string
# open | invite | closed
MSGR_REGISTRATION=invite
# Server image; the installer sets it. Remove to build from source with `docker compose up --build`.
MSGR_IMAGE=ghcr.io/william-aqn/family-messenger-e2e:latest
